[Unit]
Description=Ghost Recon Future Soldier server
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/grfs-emulator
ExecStart=/usr/bin/python3 -X utf8 -m grfs --config /etc/grfs-emulator/grfs.ini --data-dir /var/lib/grfs-emulator
Environment=GRFS_RUNTIME_DIR=/opt/grfs-emulator
Environment=GRFS_LOG_FILE=/var/log/grfs-emulator/grfs.log
StateDirectory=grfs-emulator
LogsDirectory=grfs-emulator
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
