# Machine-specific settings with real addresses.
grfs.ini

# Runtime state and logs. The log carries account names; the register carries names and pids.
logs/
data/

__pycache__/
*.pyc

# Publish only the portable Windows package; keep archives, downloads and local state out.
dist/*
!dist/GRFS-Server.exe
!dist/GRFS-Client.exe
!dist/grfs.ini.example
!dist/WINDOWS.md
!dist/app/
!dist/python/

# Windows executable build environment and intermediate files.
.venv-build/
build/
